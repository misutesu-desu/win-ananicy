<Window x:Class="WinAnanicyGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WinAnanicy"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="7"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0E1525" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="30" Height="30" Source="Assets/win-ananicy-icon.png"/>
                    <TextBlock Text="WinAnanicy" FontWeight="SemiBold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource AppTagline}" Style="{StaticResource MutedText}" Margin="12,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ComboBox x:Name="LanguageComboBox"
                          Grid.Column="1"
                          Width="104"
                          Height="32"
                          MinHeight="32"
                          Margin="8,0,10,0"
                          VerticalAlignment="Center"
                          SelectionChanged="LanguageComboBox_SelectionChanged"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True"
                          AutomationProperties.Name="{DynamicResource Language}">
                    <ComboBoxItem Tag="en">English</ComboBoxItem>
                    <ComboBoxItem Tag="tr">Türkçe</ComboBoxItem>
                </ComboBox>
                <Button Grid.Column="2"
                        Content="&#xE921;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="11"
                        Padding="0"
                        MinHeight="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="MinimizeButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="{DynamicResource Minimize}"/>
                <Button Grid.Column="3"
                        Content="&#xE922;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="11"
                        Padding="0"
                        MinHeight="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="MaximizeButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="{DynamicResource Maximize}"/>
                <Button Grid.Column="4"
                        Content="&#xE8BB;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="11"
                        Padding="0"
                        MinHeight="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="CloseButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="{DynamicResource Close}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="222"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#0C1322" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="14,18,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="SidebarStatusDot" Width="10" Height="10" Fill="{StaticResource DangerBrush}" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="SidebarStatusText" Text="{DynamicResource Stopped}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SidebarStatusDetail" Text="{DynamicResource StatusReady}" FontSize="11" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1">
                        <Button x:Name="DashboardNavButton" Style="{StaticResource NavButton}" Tag="Selected" Click="NavigationButton_Click" CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/><TextBlock Text="{DynamicResource Dashboard}"/></StackPanel>
                        </Button>
                        <Button x:Name="ProcessesNavButton" Style="{StaticResource NavButton}" Click="NavigationButton_Click" CommandParameter="Processes">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/><TextBlock Text="{DynamicResource Processes}"/></StackPanel>
                        </Button>
                        <Button x:Name="RulesNavButton" Style="{StaticResource NavButton}" Click="NavigationButton_Click" CommandParameter="Rules">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/><TextBlock Text="{DynamicResource Rules}"/></StackPanel>
                        </Button>
                        <Button x:Name="ActivityNavButton" Style="{StaticResource NavButton}" Click="NavigationButton_Click" CommandParameter="Activity">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/><TextBlock Text="{DynamicResource Activity}"/></StackPanel>
                        </Button>
                        <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Click="NavigationButton_Click" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/><TextBlock Text="{DynamicResource Settings}"/></StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" FontSize="11"/>
                        <TextBlock Text="Open source · GPL-3.0-or-later" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="28,24,28,18">
                <Grid x:Name="DashboardPage">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Overview}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{DynamicResource OverviewSubtitle}" Style="{StaticResource MutedText}" Margin="0,7,0,22"/>
                            <UniformGrid Columns="4" Margin="0,0,0,18">
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Engine}" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="DashboardEngineStatus" Text="{DynamicResource Stopped}" FontSize="24" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource ConfiguredRules}" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="DashboardRulesCount" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource MatchedNow}" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="DashboardMatchedCount" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource AppliedNow}" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="DashboardAppliedCount" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource QuickActions}" FontSize="17" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button x:Name="StartEngineButton" Content="{DynamicResource Start}" Style="{StaticResource PrimaryButton}" Click="StartEngineButton_Click" Margin="0,0,10,0"/>
                                        <Button x:Name="StopEngineButton" Content="{DynamicResource Stop}" Click="StopEngineButton_Click" Margin="0,0,10,0"/>
                                        <Button x:Name="RestartEngineButton" Content="{DynamicResource Restart}" Click="RestartEngineButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Background="#172448" BorderBrush="#3C54A3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource ReadyTitle}" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource ReadyText}" Style="{StaticResource MutedText}" Margin="0,7,20,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{DynamicResource GoProcesses}" Style="{StaticResource PrimaryButton}" Click="GoProcessesButton_Click" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="ProcessesPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ProcessTitle}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{DynamicResource ProcessSubtitle}" Style="{StaticResource MutedText}" Margin="0,7,0,18"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ProcessSearchTextBox"
                                 ToolTip="{DynamicResource Search}"
                                 TextChanged="ProcessSearchTextBox_TextChanged"
                                 AutomationProperties.Name="{DynamicResource Search}"/>
                        <Button Grid.Column="2" Content="{DynamicResource Refresh}" Click="RefreshProcessesButton_Click" Margin="0,0,10,0"/>
                        <Button Grid.Column="3" Content="{DynamicResource AddRule}" Style="{StaticResource PrimaryButton}" Click="AddRuleFromProcessButton_Click"/>
                    </Grid>
                    <DataGrid x:Name="ProcessesDataGrid" Grid.Row="2" MouseDoubleClick="ProcessesDataGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Name}" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource Pid}" Binding="{Binding Id}" Width="90"/>
                            <DataGridTextColumn Header="{DynamicResource Cpu}" Binding="{Binding CpuPercent, StringFormat={}{0:F1}%}" Width="100"/>
                            <DataGridTextColumn Header="{DynamicResource Memory}" Binding="{Binding MemoryMb, StringFormat={}{0} MB}" Width="120"/>
                            <DataGridTextColumn Header="{DynamicResource Rule}" Binding="{Binding RuleState}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid x:Name="RulesPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource RuleTitle}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{DynamicResource RuleSubtitle}" Style="{StaticResource MutedText}" Margin="0,7,0,18"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                        <Button Content="{DynamicResource Import}" Click="ImportRulesButton_Click" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource Export}" Click="ExportRulesButton_Click" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource Edit}" Click="EditRuleButton_Click" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource Delete}" Style="{StaticResource DangerButton}" Click="DeleteRuleButton_Click" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource NewRule}" Style="{StaticResource PrimaryButton}" Click="NewRuleButton_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="RulesDataGrid" Grid.Row="2" MouseDoubleClick="RulesDataGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource ProcessName}" Binding="{Binding ProcessName}" Width="2*"/>
                            <DataGridTextColumn Header="{DynamicResource Profile}" Binding="{Binding ProfileSummary}" Width="3*"/>
                            <DataGridCheckBoxColumn Header="{DynamicResource BackgroundOnly}" Binding="{Binding BackgroundOnly}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid x:Name="ActivityPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ActivityTitle}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{DynamicResource ActivitySubtitle}" Style="{StaticResource MutedText}" Margin="0,7,0,18"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                        <Button Content="{DynamicResource Refresh}" Click="RefreshLogButton_Click" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource OpenLogFolder}" Click="OpenLogFolderButton_Click"/>
                    </StackPanel>
                    <TextBox x:Name="LogTextBox"
                             Grid.Row="2"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </Grid>

                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource GeneralSettings}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{DynamicResource SettingsSubtitle}" Style="{StaticResource MutedText}" Margin="0,7,0,18"/>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <CheckBox x:Name="PowerPlanCheckBox" Content="{DynamicResource PowerPlan}"/>
                                        <TextBlock Text="{DynamicResource PowerPlanHelp}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="22,0,0,10"/>
                                        <TextBlock Text="{DynamicResource PollInterval}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="PollIntervalTextBox"/>
                                        <TextBlock Text="{DynamicResource TrimCooldown}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TrimCooldownTextBox"/>
                                        <TextBlock Text="{DynamicResource WatchdogRetries}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="WatchdogRetriesTextBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <CheckBox x:Name="StartupCheckBox" Content="{DynamicResource Startup}"/>
                                        <CheckBox x:Name="MinimizeTrayCheckBox" Content="{DynamicResource MinimizeTray}"/>
                                        <TextBlock Text="{DynamicResource Language}" Style="{StaticResource FieldLabel}" Margin="0,22,0,5"/>
                                        <ComboBox x:Name="SettingsLanguageComboBox" SelectionChanged="SettingsLanguageComboBox_SelectionChanged">
                                            <ComboBoxItem Tag="en">English</ComboBoxItem>
                                            <ComboBoxItem Tag="tr">Türkçe</ComboBoxItem>
                                        </ComboBox>
                                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                            <Button Content="{DynamicResource DataFolder}" Click="OpenDataFolderButton_Click" Margin="0,0,8,0"/>
                                            <Button Content="{DynamicResource SaveSettings}" Style="{StaticResource PrimaryButton}" Click="SaveSettingsButton_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#0D1424" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatusText" Text="{DynamicResource StatusReady}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="FooterPathText" Grid.Column="1" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border x:Name="RuleEditorOverlay"
                Grid.RowSpan="3"
                Background="#D9090E1A"
                Visibility="Collapsed"
                Panel.ZIndex="20">
            <Border Width="620"
                    MaxHeight="700"
                    Style="{StaticResource CardStyle}"
                    Background="#131C30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="24,20,24,14">
                        <TextBlock Text="{DynamicResource RuleEditor}" FontSize="22" FontWeight="SemiBold"/>
                        <Button Content="&#xE8BB;"
                                FontFamily="Segoe Fluent Icons"
                                Width="36"
                                Height="32"
                                MinHeight="0"
                                Padding="0"
                                HorizontalAlignment="Right"
                                Click="CancelRuleButton_Click"
                                AutomationProperties.Name="{DynamicResource Cancel}"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,0,16,0">
                        <StackPanel Margin="0,0,8,12">
                            <TextBlock Text="{DynamicResource ProcessName}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="RuleProcessNameTextBox"/>
                            <TextBlock Text="{DynamicResource Preset}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="PresetComboBox" SelectionChanged="PresetComboBox_SelectionChanged">
                                <ComboBoxItem Tag="" Content="{DynamicResource PresetCustom}"/>
                                <ComboBoxItem Tag="game" Content="{DynamicResource PresetGame}"/>
                                <ComboBoxItem Tag="balanced" Content="{DynamicResource PresetBalanced}"/>
                                <ComboBoxItem Tag="background" Content="{DynamicResource PresetBackground}"/>
                                <ComboBoxItem Tag="saver" Content="{DynamicResource PresetSaver}"/>
                            </ComboBox>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource CpuPriority}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CpuPriorityComboBox">
                                        <ComboBoxItem Tag="" Content="{DynamicResource NoChange}"/>
                                        <ComboBoxItem Tag="Idle">Idle</ComboBoxItem>
                                        <ComboBoxItem Tag="Below Normal">Below Normal</ComboBoxItem>
                                        <ComboBoxItem Tag="Normal">Normal</ComboBoxItem>
                                        <ComboBoxItem Tag="Above Normal">Above Normal</ComboBoxItem>
                                        <ComboBoxItem Tag="High">High</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource IoPriority}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="IoPriorityComboBox">
                                        <ComboBoxItem Tag="" Content="{DynamicResource NoChange}"/>
                                        <ComboBoxItem Tag="Very Low">Very Low</ComboBoxItem>
                                        <ComboBoxItem Tag="Low">Low</ComboBoxItem>
                                        <ComboBoxItem Tag="Normal">Normal</ComboBoxItem>
                                        <ComboBoxItem Tag="High">High</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{DynamicResource Affinity}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CpuAffinityTextBox"/>
                            <TextBlock Text="{DynamicResource AffinityHelp}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource CpuLimit}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CpuLimitTextBox" Text="0"/>
                                    <TextBlock Text="{DynamicResource SmartTrim}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SmartTrimTextBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource ThrottleTrigger}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ThrottleTriggerTextBox"/>
                                    <TextBlock Text="{DynamicResource ThrottleDuration}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ThrottleDurationTextBox"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="#0D1424" CornerRadius="8" Padding="12" Margin="0,14,0,4">
                                <StackPanel>
                                    <CheckBox x:Name="BackgroundOnlyCheckBox" Content="{DynamicResource BackgroundOnly}"/>
                                    <CheckBox x:Name="EcoQosCheckBox" Content="{DynamicResource EcoQos}"/>
                                    <CheckBox x:Name="LauncherCheckBox" Content="{DynamicResource Launcher}"/>
                                    <CheckBox x:Name="InstanceBalanceCheckBox" Content="{DynamicResource InstanceBalance}"/>
                                    <CheckBox x:Name="DisallowedCheckBox" Content="{DynamicResource Disallowed}"/>
                                    <CheckBox x:Name="KeepAliveCheckBox" Content="{DynamicResource KeepAlive}" Checked="KeepAliveCheckBox_Changed" Unchecked="KeepAliveCheckBox_Changed"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{DynamicResource ExecutablePath}" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ExecutablePathTextBox"/>
                                <Button Grid.Column="1" Content="{DynamicResource Browse}" Click="BrowseExecutableButton_Click" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock x:Name="RuleValidationText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource Cancel}" Click="CancelRuleButton_Click" Margin="0,0,8,0"/>
                            <Button Content="{DynamicResource SaveRule}" Style="{StaticResource PrimaryButton}" Click="SaveRuleButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
