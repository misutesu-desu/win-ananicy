<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WinAnanicy</AssemblyName>
    <RootNamespace>WinAnanicyGui</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>WinAnanicy</Product>
    <Company>Abdullah Çafer (misutesu-desu)</Company>
    <Description>Smart, lightweight process optimization for Windows.</Description>
    <Authors>Abdullah Çafer (misutesu-desu)</Authors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\win-ananicy.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\assets\win-ananicy-icon.png" Link="Assets\win-ananicy-icon.png"/>
  </ItemGroup>

</Project>
